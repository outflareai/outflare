{
  "name": "@outflare/react-native",
  "version": "0.110.0",
  "description": "Send screens and events from a React Native app to Outflare",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outflareai/outflare.git",
    "directory": "sdk/react-native"
  },
  "homepage": "https://outflare.ai/docs/sdk/mobile/",
  "bugs": "https://github.com/outflareai/outflare/issues",
  "keywords": [
    "outflare",
    "react-native",
    "analytics",
    "events"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
