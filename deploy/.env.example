# Copy to deploy/.env and adjust. Docker Compose reads it automatically.

# Change this before exposing the instance anywhere.
POSTGRES_PASSWORD=outflare

# Port the app and API are served on.
PORT=8080

# The address people reach this instance on. Unsubscribe links in every
# email point here, so set it to your public https URL before sending.
PUBLIC_URL=http://localhost:8080

# Encrypts mailbox passwords and provider keys at rest. Required.
# Generate with: openssl rand -base64 32
# Back it up: if it is lost, stored mailbox credentials cannot be read.
OUTFLARE_SECRET_KEY=
# To rotate the key: put the current one here and a new one above, then
# restart. Stored secrets are re-encrypted with the new key at start-up.
OUTFLARE_SECRET_KEY_PREVIOUS=

# Optional: your own OAuth apps, for the "Connect a Google/Microsoft
# mailbox" consent screen (redirect URI $PUBLIC_URL/v1/oauth/callback) and,
# for Google, "Continue with Google" sign-in (also add
# $PUBLIC_URL/v1/auth/google/callback). Admin connections (service account,
# Entra app) and password mailboxes work without these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Passkey sign-in turns on once PUBLIC_URL is https. Passkeys are tied to
# that address, so set it to the one you'll keep. off, on or auto (default).
# PASSKEYS=auto

# Optional: account emails (confirming an address, resetting a password).
# Use Postmark, Resend or Cloudflare Email Service (one of them), not a
# cold-email mailbox. Without one, the links are only written to the server log.
# EMAIL_FROM="Outflare <login@example.com>"
# POSTMARK_SERVER_TOKEN=
# RESEND_API_KEY=
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Behind a proxy (Fly.io, Cloudflare), the header it puts the visitor's
# address in, so rate limits see real visitors. Leave empty otherwise.
# CLIENT_IP_HEADER=Fly-Client-IP

# Webhooks only go to public https URLs. Set true to allow private,
# loopback and plain-http addresses, when your receivers are on the same
# network as the server.
# WEBHOOKS_ALLOW_PRIVATE=false

# Requests per minute each API token may make (0 for no limit).
# API_RATE_LIMIT=600

# Days to keep request logs (the Logs page).
# OUTFLARE_LOG_RETENTION_DAYS=30

# Analytics storage (docs/analytics-storage.md). All optional: without
# them product events stay in Postgres.
# ClickHouse copy of product events, for fast reports over large volumes.
# OUTFLARE_CLICKHOUSE_URL=http://user:password@clickhouse.example.com:8123/outflare
# S3-compatible bucket (Cloudflare R2, Amazon S3, MinIO) for archived
# events and, later, session recordings. Set all or none.
# OUTFLARE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# OUTFLARE_S3_REGION=auto
# OUTFLARE_S3_BUCKET=outflare
# OUTFLARE_S3_ACCESS_KEY_ID=
# OUTFLARE_S3_SECRET_ACCESS_KEY=
# Days to keep product events in Postgres (0 keeps them forever; 30 to
# 3650). Older events move to the bucket when one is set, else are removed.
# OUTFLARE_EVENT_RETENTION_DAYS=0

# Your website on a parent domain of PUBLIC_URL (example.com for
# app.example.com) can show "Dashboard" instead of "Sign in": the server
# keeps an outflare_signed_in=1 cookie there while someone is signed in.
# It holds nothing else; the session cookie never leaves PUBLIC_URL's host.
# OUTFLARE_SIGNED_IN_COOKIE_DOMAIN=example.com

# Prometheus metrics (docs/monitoring.md) on a private port inside Docker,
# never published. Set empty to turn them off. With a token, scrapers must
# send it as a bearer token. PPROF also serves Go's profiler there.
# OUTFLARE_METRICS_ADDR=:9091
# OUTFLARE_METRICS_TOKEN=
# OUTFLARE_METRICS_PPROF=false

# Dashboards and alerts: docker compose --profile monitoring up -d, then
# Grafana on http://localhost:3000 as admin with this password (set one
# before the first start; Grafana keeps it in its volume).
# GRAFANA_ADMIN_PASSWORD=
# PROMETHEUS_RETENTION=30d

# Concurrent job workers (sending, inbox sync, connection checks).
WORKERS=32

# What this process does (docs/scaling.md). all (the default) runs
# everything in one process. A large install runs the same image as
# separate services: api (the app and API), ingest (website events and
# site.js) and worker (jobs and background loops).
# OUTFLARE_ROLE=all

# Anonymous daily usage report and update check (docs/telemetry.md). Set to off to stop it.
# OUTFLARE_TELEMETRY=off
